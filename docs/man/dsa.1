.SH NAME
dsa \- terminal game for training C++ DSA pattern recognition
.
.SH SYNOPSIS
.B dsa
.RI [ COMMAND ]
.RI [ OPTIONS ]
.PP
.B dsa
.RB [ --db
.IR PATH ]
.br
.B dsa practice
.RB [ --size
.IR N ]
.RB [ --db
.IR PATH ]
.br
.B dsa review
.RB [ --size
.IR N ]
.RB [ --db
.IR PATH ]
.br
.B dsa stats
.RB [ --db
.IR PATH ]
.br
.B dsa patterns
.RB [ --db
.IR PATH ]
.br
.B dsa pattern
.I PATTERN_ID
.RB [ --template ]
